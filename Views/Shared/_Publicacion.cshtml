@model Publicacion
@*
    Este parcial se usa de dos maneras:
    1) Razor lo dibuja para las primeras 10 publicaciones.
    2) Se dibuja vacío dentro de un <template> y feed.js lo clona y completa
       con los datos que llegan por Fetch al tocar "Ver más".
*@
<article class="post" data-id="@Model.Id">
    <header class="post-cabecera">
        <span class="avatar post-avatar" style="--tono:@Model.Tono">@Model.Inicial</span>
        <div class="post-autor">
            <strong class="post-usuario">@Model.NombreUsuario</strong>
            <time class="post-fecha">@Model.FechaFormateada</time>
        </div>
    </header>

    <figure class="post-foto">
        <img class="post-imagen" src="@Model.UrlImagen" alt="@Model.Titulo" loading="lazy"
             onerror="this.onerror=null;this.src='@Url.Content("~/img/sin-imagen.svg")'" />
    </figure>

    <div class="post-cuerpo">
        <div class="post-acciones">
            <button type="button" class="boton-like @(Model.UsuarioDioMeGusta ? "activo" : "")"
                    aria-pressed="@(Model.UsuarioDioMeGusta ? "true" : "false")">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.5 8 3.6 4.5 7.1 4.5c2 0 3.6 1.1 4.9 2.9 1.3-1.8 2.9-2.9 4.9-2.9 3.5 0 5.6 3.5 4.4 6.8-1.8 4.6-9.3 9.2-9.3 9.2z" /></svg>
                <span class="like-etiqueta">@(Model.UsuarioDioMeGusta ? "Ya no me gusta" : "Me gusta")</span>
            </button>
            <span class="contador"><b class="like-cantidad">@Model.CantidadMeGusta</b> me gusta</span>
            <span class="contador"><b class="comentarios-cantidad">@Model.Comentarios.Count</b> comentarios</span>
        </div>

        <h2 class="post-titulo">@Model.Titulo</h2>
        <p class="post-descripcion">@Model.Descripcion</p>
    </div>

    <section class="post-comentarios" aria-label="Comentarios">
        <ul class="lista-comentarios">
            @foreach (Comentario comentario in Model.Comentarios)
            {
                <partial name="_Comentario" model="comentario" />
            }
        </ul>
        <form class="form-comentario">
            <input type="text" name="texto" placeholder="Escribí un comentario…" maxlength="500"
                   aria-label="Comentario" autocomplete="off" />
            <button type="submit">Comentar</button>
        </form>
        <p class="error-comentario" role="alert" hidden></p>
    </section>
</article>
